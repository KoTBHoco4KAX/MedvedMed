# ─────────────────────────────────────────────────────────────
# МедВед — пример переменных окружения
# Скопируйте в .env и замените все значения-заглушки.
# Реальный .env нельзя коммитить: он уже добавлен в .gitignore.
# ─────────────────────────────────────────────────────────────

# ── HTTP-сервер ───────────────────────────────────────────────
PORT=8080

# false — боевой режим с MAX Core; true — моковый пользователь для разработки.
DEV_MODE=false

# ── Файлы приложения ─────────────────────────────────────────
# Локальный путь к SQLite. В docker-compose переопределяется на /app/data/medbot.db.
DB_PATH=./medbot.db

# Локальный путь к собранному фронтенду. В Docker: /app/frontend/dist.
STATIC_DIR=./frontend/dist

# ── MAX Core API ──────────────────────────────────────────────
# Адрес Core API MAX (без завершающего слэша).
CORE_URL=https://core.example.ru

# Сервисный Bearer-токен для запросов к Core API.
CORE_SERVICE_TOKEN=your-core-service-token-here

# ── DeepSeek ──────────────────────────────────────────────────
# Пустое значение допустимо: тогда работают только локальные правила без LLM.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ── Сессии ────────────────────────────────────────────────────
# Секрет для подписи/сессий. Замените на длинную случайную строку.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Tuna tunnel (Docker) ──────────────────────────────────────
# Домен без схемы: Tuna сама выставит https://.
TUNA_DOMAIN=medvedmed.ru

# API-ключ Tuna из личного кабинета.
# Обязателен для Docker-развёртывания: контейнер Tuna входит по нему
# автоматически, без браузера. Создайте ключ с правом «Для туннелей»:
# https://my.tuna.am/api_keys
# В docker-compose он передаётся как TUNA_API_KEY, в command его писать не нужно.
TUNA_API_KEY=tak_your_tuna_api_key_here

# Публичный адрес мини-приложения.
# Если оставить пустым, приложение построит его из https://${TUNA_DOMAIN}.
PUBLIC_URL=https://medvedmed.ru

# ── Необязательно ─────────────────────────────────────────────
# Принудительный IPv4 для Tuna; docker-compose уже передаёт это значение.
# TUNA_FORCE_IPV4=1

# Токен бота MAX для настройки мини-приложения.
# Текущий Go-бэкенд его не читает и не логирует.
# MAX_BOT_TOKEN=your-max-bot-token-here

TZ=UTC
